# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# SQL Server sa password. Must satisfy SQL Server's complexity policy (8+ chars, upper +
# lower + digit + symbol).
SQL_SA_PASSWORD=Change_Me_123!

# JWT signing key. 32+ characters, random, secret — generate a new one per environment.
JWT_KEY=Change_Me_To_A_Random_32_Char_Minimum_Secret

# Stripe (online payments). Leave blank to run with the no-op payment gateway (logs instead of
# charging anyone) — the app degrades gracefully without a Stripe account. Use TEST-mode keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Public base URL the app is reachable at, used to build Stripe Checkout success/cancel
# redirect links. Falls back to the request's own scheme+host if left blank.
APP_PUBLIC_URL=

# Hangfire dashboard (/hangfire) HTTP Basic Auth. Leave both blank to run with the local-dev
# default (only requests from localhost are allowed) — set both before deploying anywhere
# network-reachable, or the dashboard becomes unreachable from outside the host entirely.
HANGFIRE_DASHBOARD_USERNAME=
HANGFIRE_DASHBOARD_PASSWORD=

# SMTP (forgot-password / reset-password emails). Leave SMTP_HOST blank to run with the
# logging-only email sender (writes to the app log instead of sending) — the app degrades
# gracefully without an SMTP account, but no reset email actually reaches a user until this is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Real Estate CRM

# WhatsApp Business Cloud API (Meta Graph API). Leave both blank to run with the logging-only
# WhatsApp sender (logs instead of sending) — the app degrades gracefully without a WhatsApp
# Business account. Get these from Meta's WhatsApp Business Platform / Graph API setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
